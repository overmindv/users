type User {
  id: ID!
  email: String!
  username: String!
  firstName: String!
  lastName: String!
  birthDate: String
  phone: String
  avatarFileId: ID
  roles: [String!]!
  isAdmin: Boolean!
  isSuperuser: Boolean!
  createdAt: String!
  updatedAt: String!
}

type PublicUser {
  id: ID!
  username: String!
  firstName: String!
  lastName: String!
  avatarFileId: ID
  isAdmin: Boolean!
  createdAt: String!
}

type AuthPayload {
  user: User!
  token: String!
  expiresAt: String!
}

input RegisterInput {
  email: String!
  password: String!
  username: String!
  firstName: String = ""
  lastName: String = ""
  birthDate: String
  phone: String = ""
}

input LoginInput {
  email: String!
  password: String!
}

input UpdateUserInput {
  username: String
  firstName: String
  lastName: String
  birthDate: String
  clearBirthDate: Boolean = false
  phone: String
}

type Query {
  me: User!
  user(id: ID!): User!
  userByUsername(username: String!): User!
  users(search: String = "", limit: Int = 20, offset: Int = 0): [User!]!
  publicUser(id: ID!): PublicUser!
  publicUsers(search: String!, limit: Int = 20, offset: Int = 0): [PublicUser!]!
}

type Mutation {
  register(input: RegisterInput!): AuthPayload!
  login(input: LoginInput!): AuthPayload!
  updateUser(id: ID!, input: UpdateUserInput!): User!
  setMyAvatar(fileId: ID): User!
  deleteUser(id: ID!): Boolean!
  setUserAdmin(id: ID!, admin: Boolean!): User!
  setUserAdminByUsername(username: String!, admin: Boolean!): User!
}
